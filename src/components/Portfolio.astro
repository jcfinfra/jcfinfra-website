---
import Head from './Head.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import {portfolio,labSlugs} from '../data/portfolio';
import '../styles/global.css';
interface Props {lang:'en'|'es'}
const {lang='en'}=Astro.props;const c=portfolio[lang];const es=lang==='es';const labPath=(i:number)=>(es?'/es/labs/':'/labs/')+labSlugs[i]+'/';
---
<!doctype html><html lang={lang}><head><Head lang={lang} title={c.title} description={c.intro} enPath="/" esPath="/es/"/></head><body><Header lang={lang}/>
<main id="main" tabindex="-1">
<section class="hero"><div class="wrap hero-grid"><div><p class="eyebrow">Juan Carlos Flores · {c.location}</p><h1>{c.headline.map(line=><span>{line}</span>)}</h1><p class="lead">{c.lead}</p><div class="actions"><a class="button" href="#projects">{c.explore} <span aria-hidden="true">↗</span></a><a class="button secondary" href="#contact">{c.contact}</a><a class="button secondary" href={es?'/es/cv/':'/cv/'} lang={lang}>{es ? "Ver CV" : "View CV"}</a></div></div><aside class="lab-index panel" aria-label={c.labIndex}><p class="eyebrow">{c.labIndex}</p>{c.labTitles.map((title,i)=><a href={labPath(i)}><span class="index-number">0{i+1}</span><span>{title}<small>{['Cloudflare · WAF','Azure · Bicep · IIS','Azure · Load Balancer'][i]}</small></span><span aria-hidden="true">↗</span></a>)}</aside></div></section>
<section id="about" class="section"><div class="wrap split"><div><span class="section-number">01 / {c.labels[0]}</span><h2>{c.about}</h2></div><div class="about-copy"><p>{c.intro}</p><p class="muted">{c.learning}</p></div></div></section>
<section id="experience" class="section"><div class="wrap"><div class="section-heading"><span class="section-number">02 / {c.labels[1]}</span><h2>{c.experience}</h2><p>{c.experienceIntro}</p></div><div class="experience-grid">{c.duties.map(([title,text],i)=><article class="panel"><p class="eyebrow">0{i+1}</p><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
<section id="skills" class="section"><div class="wrap"><span class="section-number">03 / {c.labels[2]}</span><h2>{c.skills}</h2><div class="grid-three">{c.groups.map(([title,text])=><article class="panel"><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
<section id="projects" class="section"><div class="wrap"><div class="section-heading"><span class="section-number">04 / {c.labels[3]}</span><h2>{c.projects}</h2><p>{c.projectIntro}</p></div><div class="grid-three">{c.labTitles.map((title,i)=><article class="panel project"><p class="eyebrow">LAB-00{i+1} / {i===0?'Cloudflare':'Azure'}</p><h3><a href={labPath(i)}>{title}</a></h3><p>{c.labSummaries[i]}</p><p class="result">{c.labResults[i]}</p><a class="case-link" href={labPath(i)} aria-label={`${c.read}: ${title}`}>{c.read} <span aria-hidden="true">↗</span></a></article>)}</div><p class="historical muted">{c.historical}</p><div class="planned"><h3>{c.planned}</h3><p class="muted">{c.plans}</p></div></div></section>
<section id="certifications" class="section"><div class="wrap split"><div><span class="section-number">05 / {c.labels[4]}</span><h2>{c.certs}</h2></div><div><p>{c.certsIntro}</p><ul class="credentials"><li><a href="https://learn.microsoft.com/en-us/users/juancarlosfloresaroni-0554/credentials/a07127379f2368d0">Microsoft Certified: Azure Network Engineer Associate</a><br/><small>{es?'Vigente hasta el 10 de octubre de 2027':'Valid until 10 October 2027'}</small></li><li><a href="https://catalog-education.oracle.com/ords/certview/sharebadge?id=E252AC4263B446BC4175C3A61284273750C749489F8984516E9B96474490DA17">OCI 2025 Certified Architect Associate</a><br/><small>{es?'Vigente hasta el 1 de noviembre de 2027':'Valid until 1 November 2027'}</small></li><li><a href="https://www.credly.com/badges/e6735316-9ee7-436a-ace6-5740c34a4f04/public_url">Fortinet Certified Professional Secure Networking</a><br/><small>{es?'Vigente hasta el 14 de octubre de 2027':'Valid until 14 October 2027'}</small></li></ul><p class="muted">{c.certsNote}</p><a class="button secondary" href={es?'/es/cv/':'/cv/'} lang={lang}>{es?'Ver experiencia y formación en el CV':'View experience and training in the CV'}</a></div></div></section>
<section id="contact" class="section"><div class="wrap"><div class="contact-panel panel"><div><span class="section-number">06 / {c.labels[5]}</span><h2>{c.contactTitle}</h2><p>{c.contactText}</p></div><div><a class="email" href="mailto:juan@jcfinfra.com">juan@jcfinfra.com <span aria-hidden="true">↗</span></a><div class="footer-links"><a href="https://github.com/jcfinfra">GitHub ↗</a><a href="https://www.linkedin.com/in/juan-carlos-aroni/">LinkedIn ↗</a></div></div></div></div></section>
</main><Footer lang={lang}/></body></html>
<style>
.hero{padding:88px 0 96px;background:radial-gradient(ellipse at 100% 0%,#14243b 0,transparent 60%)}.hero-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:64px;align-items:center}h1 span{display:block}.lab-index{padding:28px}.lab-index>a{display:grid;grid-template-columns:24px 1fr 16px;align-items:start;gap:14px;padding:24px 0;border-bottom:1px solid var(--border);color:var(--text);text-decoration:none;font-weight:550;line-height:1.5}.lab-index>a:last-child{border-bottom:0;padding-bottom:0}.lab-index>a:hover{color:var(--accent)}.index-number{font:.8rem 'JetBrains Mono',monospace;color:var(--accent);padding-top:3px}.lab-index small{display:block;color:var(--muted);font-size:.76rem;font-weight:400;margin-top:8px}.split{display:grid;grid-template-columns:1fr 1.2fr;gap:80px}.about-copy{font-size:1.08rem}.experience-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.panel h3{margin-top:0}.project{display:flex;flex-direction:column}.project h3{font-size:1.45rem;line-height:1.3}.project h3 a{color:var(--text);text-decoration:none}.project h3 a:hover{color:var(--accent)}.project .result{font-size:.84rem;border-top:1px solid var(--border);padding-top:18px;color:var(--text);margin-top:auto}.case-link{font-size:.9rem;font-weight:600;min-height:44px;display:flex;align-items:center;justify-content:space-between}.historical{font-size:.8rem;margin:18px 0 32px}.planned{border-left:2px solid var(--border);padding-left:24px;max-width:780px}.planned h3{font-size:1rem}.credential-names{display:flex;gap:8px;flex-wrap:wrap;margin:24px 0}.contact-panel{padding:40px;display:flex;align-items:center;justify-content:space-between;gap:32px}.contact-panel h2{margin-bottom:12px}.email{font-size:clamp(1rem,2.3vw,1.5rem);font-weight:600;display:block;margin-bottom:20px}.contact-panel .footer-links{font-size:.88rem}@media(max-width:1000px){.hero-grid{grid-template-columns:1fr;gap:40px}.hero{padding:56px 0}.lab-index{max-width:680px}.split{grid-template-columns:1fr;gap:12px}.experience-grid{grid-template-columns:1fr}.contact-panel{align-items:flex-start;flex-direction:column}.hero h1{font-size:clamp(2.3rem,7vw,4.5rem)}}@media(max-width:480px){.hero{padding:44px 0 48px}.lab-index{padding:24px}.contact-panel{padding:24px}}
</style>
