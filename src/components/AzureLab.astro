---
import LabLayout from '../layouts/LabLayout.astro';
import { evidenceSizes } from '../data/evidenceSizes';
import { azureLabs } from '../data/azureLabs';
interface Props { lab: '002' | '003'; lang: 'en' | 'es'; }
const { lab, lang } = Astro.props;
const es = lang === 'es';
const entry = azureLabs[lab];
const copy = entry[lang];
const repairScript = String.raw`Install-WindowsFeature -Name Web-Server -IncludeManagementTools
Remove-Item 'C:\inetpub\wwwroot\iisstart.htm' -Force
Set-Content -Path 'C:\inetpub\wwwroot\iisstart.htm' -Value $env:COMPUTERNAME`;
---
<LabLayout lang={lang} slug={entry.slug} title={`LAB-${lab} · ${copy.title}`} description={copy.summary}>
  <div class="hero"><div class="wrap"><p class="eyebrow">{es ? 'REDES AZURE' : 'AZURE NETWORKING'} / LAB-{lab}</p><h1>{copy.title}</h1><p class="lead">{copy.summary}</p><span class="badge">AZ-700 · {entry.module}</span><span class="badge">{copy.date}</span><span class="badge">{es ? 'Evidencia original' : 'Original evidence'}</span></div></div>
  <div class="wrap content">
    <p class="notice"><strong>{es ? 'Resultado documentado: ' : 'Documented outcome: '}</strong>{copy.outcome}</p>
    <nav class="toc" aria-label={es ? 'Contenido del laboratorio' : 'Lab contents'}><a href="#architecture">{es ? 'Arquitectura' : 'Architecture'}</a><a href="#decisions">{es ? 'Adaptaciones' : 'Adaptations'}</a><a href="#validation">{es ? 'Validación' : 'Validation'}</a><a href="#evidence">{es ? 'Evidencias' : 'Evidence'}</a><a href="#reproduction">{es ? 'Reproducción' : 'Reproduction'}</a><a href="#limits">{es ? 'Limitaciones' : 'Limits'}</a></nav>
    <section id="architecture"><h2>{es ? '01 / Arquitectura y objetivo' : '01 / Architecture and objective'}</h2><p>{copy.context}</p><pre class="flow" tabindex="0">{copy.diagram}</pre><p>{copy.architectureNote}</p></section>
    <section id="decisions"><h2>{es ? '02 / Adaptaciones y decisiones' : '02 / Adaptations and decisions'}</h2>{copy.decisions.map(item => <div><h3>{item.title}</h3><p>{item.text}</p></div>)}<h3>{copy.codeTitle}</h3><pre tabindex="0"><code>{entry.code}</code></pre><p>{copy.codeNote}</p></section>
    <section id="validation"><h2>{es ? '03 / Validación y resultados' : '03 / Validation and results'}</h2><div class="table-wrap" tabindex="0" role="region" aria-label={es ? 'Resultados de validación; tabla desplazable' : 'Validation results; scrollable table'}><table><caption>{es ? 'Qué demuestra cada comprobación' : 'What each check establishes'}</caption><thead><tr><th scope="col">{es ? 'Comprobación' : 'Check'}</th><th scope="col">{es ? 'Resultado registrado' : 'Recorded result'}</th><th scope="col">{es ? 'Límite' : 'Boundary'}</th></tr></thead><tbody>{copy.checks.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody></table></div></section>
    <section id="evidence"><h2>{es ? '04 / Evidencias originales' : '04 / Original evidence'}</h2><p>{es ? 'Capturas que tomé durante el laboratorio. Recorté las copias públicas para excluir datos personales e interfaz ajena al resultado. No se reconstruyeron ni generaron con IA, y conservo los originales. Las capturas mantienen su idioma original.' : 'Screenshots I took during the lab. I cropped the public copies to exclude personal details and unrelated interface elements. Nothing was reconstructed or AI-generated, and I keep the originals. Screenshots keep their original language.'}</p>{entry.images.map((file, index) => <figure><a href={`/labs/${lab}/${file}`}><img src={`/labs/${lab}/${file}`} alt={copy.captions[index]} {...evidenceSizes[`/labs/${lab}/${file}`]} loading="lazy" decoding="async" /></a><figcaption>{copy.captions[index]}</figcaption><a class="evidence-open" href={`/labs/${lab}/${file}`}>{es ? 'Abrir captura publicada' : 'Open published screenshot'} ↗</a></figure>)}</section>
    <section id="reproduction"><h2>{es ? '05 / Guía de reproducción' : '05 / Reproduction guide'}</h2><p>{copy.reproductionNote}</p><ol>{copy.reproduction.map(step => <li>{step}</li>)}</ol>{lab === '003' && <><h3>{es ? 'Reparación registrada en E03' : 'Repair recorded in E03'}</h3><pre tabindex="0"><code>{repairScript}</code></pre><p>{es ? 'Transcripción de E03: instala IIS y reemplaza iisstart.htm con el nombre del equipo. Solo es apropiado para una VM de laboratorio dedicada con una página desechable; conservar una copia antes de reproducirlo. No se ejecutó durante esta revisión.' : 'Transcription of E03: installs IIS and replaces iisstart.htm with the computer name. Only suitable for a dedicated lab VM with a disposable page; preserve a copy before reproducing it. Not executed during this review.'}</p></>}<p>{es ? 'Procedencia y límites: ' : 'Provenance and boundaries: '}<a href={`https://github.com/jcfinfra/jcfinfra-website/blob/main/docs/LABS-EVIDENCE.md#lab-${lab}`}>{es ? 'Registro de evidencias' : 'Evidence register'}</a>.</p></section>
    <section id="limits"><h2>{es ? '06 / Alcance y lecciones' : '06 / Scope and lessons'}</h2><ul>{copy.limits.map(item => <li>{item}</li>)}</ul><p><strong>{es ? 'Lección práctica: ' : 'Practical lesson: '}</strong>{copy.lesson}</p><h3>{es ? 'Origen y referencias' : 'Source and references'}</h3><p>{copy.provenance}</p><ul>{entry.references.map(ref => <li><a href={ref.url}>{ref.label}</a></li>)}</ul></section>
  </div>
</LabLayout>
