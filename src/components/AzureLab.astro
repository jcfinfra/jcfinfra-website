---
import LabLayout from '../layouts/LabLayout.astro';
import { azureLabs } from '../data/azureLabs';
interface Props { lab: '002' | '003'; lang: 'en' | 'es'; }
const { lab, lang } = Astro.props;
const es = lang === 'es';
const entry = azureLabs[lab];
const copy = entry[lang];
---
<LabLayout lang={lang} slug={entry.slug} title={`LAB-${lab} · ${copy.title}`} description={copy.summary}>
  <div class="hero"><div class="wrap"><p class="eyebrow">AZURE NETWORKING / LAB-{lab}</p><h1>{copy.title}</h1><p class="lead">{copy.summary}</p><span class="badge">AZ-700 · {entry.module}</span><span class="badge">{copy.date}</span><span class="badge">{es ? 'Evidencia histórica recuperada' : 'Recovered historical evidence'}</span></div></div>
  <div class="wrap content">
    <p class="notice"><strong>{es ? 'Resultado documentado: ' : 'Documented outcome: '}</strong>{copy.outcome}</p>
    <nav class="toc" aria-label={es ? 'Contenido del laboratorio' : 'Lab contents'}><a href="#architecture">{es ? 'Arquitectura' : 'Architecture'}</a><a href="#decisions">{es ? 'Adaptaciones' : 'Adaptations'}</a><a href="#validation">{es ? 'Validación' : 'Validation'}</a><a href="#evidence">{es ? 'Evidencias' : 'Evidence'}</a><a href="#limits">{es ? 'Limitaciones' : 'Limits'}</a></nav>
    <section id="architecture"><h2>{es ? '01 / Arquitectura y objetivo' : '01 / Architecture and objective'}</h2><p>{copy.context}</p><pre class="flow">{copy.diagram}</pre><p>{copy.architectureNote}</p></section>
    <section id="decisions"><h2>{es ? '02 / Adaptaciones y decisiones' : '02 / Adaptations and decisions'}</h2>{copy.decisions.map(item => <div><h3>{item.title}</h3><p>{item.text}</p></div>)}<h3>{copy.codeTitle}</h3><pre><code>{entry.code}</code></pre><p>{copy.codeNote}</p></section>
    <section id="validation"><h2>{es ? '03 / Validación y resultados' : '03 / Validation and results'}</h2><div class="table-wrap"><table><caption>{es ? 'Qué demuestra cada comprobación' : 'What each check establishes'}</caption><thead><tr><th scope="col">{es ? 'Comprobación' : 'Check'}</th><th scope="col">{es ? 'Resultado registrado' : 'Recorded result'}</th><th scope="col">{es ? 'Límite' : 'Boundary'}</th></tr></thead><tbody>{copy.checks.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody></table></div></section>
    <section id="evidence"><h2>{es ? '04 / Evidencias originales' : '04 / Original evidence'}</h2><p>{es ? 'Capturas enviadas durante el laboratorio y recuperadas del historial local. Las copias se recortaron con autorización para excluir datos personales e interfaz ajena al resultado. No se reconstruyeron ni generaron con IA. Se conservan los originales y el registro de procedencia. Las capturas mantienen su idioma original.' : 'Screenshots supplied during the lab and recovered from local history. With permission, publication copies were cropped to exclude personal details and unrelated interface elements. No evidence was reconstructed or AI-generated. Originals and provenance records are retained. Screenshots keep their original language.'}</p>{entry.images.map((file, index) => <figure><a href={`/labs/${lab}/${file}`}><img src={`/labs/${lab}/${file}`} alt={copy.captions[index]} loading="lazy" /></a><figcaption>{copy.captions[index]}</figcaption></figure>)}</section>
    <section id="limits"><h2>{es ? '05 / Alcance y lecciones' : '05 / Scope and lessons'}</h2><ul>{copy.limits.map(item => <li>{item}</li>)}</ul><p><strong>{es ? 'Lección práctica: ' : 'Practical lesson: '}</strong>{copy.lesson}</p><h3>{es ? 'Procedencia y referencias' : 'Provenance and references'}</h3><p>{copy.provenance}</p><ul>{entry.references.map(ref => <li><a href={ref.url}>{ref.label}</a></li>)}</ul></section>
  </div>
</LabLayout>
