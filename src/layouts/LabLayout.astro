---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props {lang:'en'|'es';title:string;description:string;slug:string}
const {lang,title,description,slug}=Astro.props;const es=lang==='es';const enPath='/labs/'+slug+'/';const esPath='/es/labs/'+slug+'/';
---
<!doctype html><html lang={lang}><head><Head lang={lang} title={title} description={description} enPath={enPath} esPath={esPath}/></head><body class="lab-page"><Header lang={lang} enPath={enPath} esPath={esPath} lab/><main id="main" tabindex="-1"><slot/></main><div class="wrap lab-back"><a href={(es?'/es/':'/')+'#projects'}>{es?'← Volver a proyectos':'← Back to projects'}</a></div><Footer lang={lang}/></body></html>
<style is:global>
.lab-page .wrap{max-width:1000px}.lab-page .hero{padding:64px 0 40px;background:radial-gradient(ellipse at top right,var(--surface),transparent 65%)}.lab-page h1{font-size:clamp(2.2rem,5vw,3.7rem);max-width:900px}.lab-page h2{font-size:clamp(1.6rem,3vw,2.1rem)}.lab-page h3{margin-top:32px}.lab-page .content section{padding:48px 0;border-bottom:1px solid var(--border)}.lab-page .content p,.lab-page .content li{color:var(--muted)}.lab-page .content strong{color:var(--text)}.lab-page .notice{border-left:3px solid var(--accent);padding:24px;background:var(--surface);border-radius:0 10px 10px 0;margin:24px 0}.lab-page .toc{display:flex;gap:8px 24px;flex-wrap:wrap;padding:16px 0;border-bottom:1px solid var(--border)}.lab-page .toc a{font-size:.88rem;display:flex;align-items:center;min-height:44px}.lab-page figure{margin:32px 0}.lab-page figure img{display:block;width:100%;height:auto;background:white;border:1px solid var(--border);border-radius:8px}.lab-page figcaption{margin-top:12px;font-size:.85rem;color:var(--muted)}.lab-page .evidence-open{display:inline-flex;min-height:44px;align-items:center;font-size:.85rem}.lab-back{padding-block:32px}.lab-page pre{color:var(--text)}@media(max-width:600px){.lab-page .hero{padding:40px 0 24px}.lab-page .content section{padding:32px 0}.lab-page .notice{padding:20px}}
</style>
