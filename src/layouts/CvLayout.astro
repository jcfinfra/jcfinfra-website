---
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const title='CV de Juan Carlos Flores Aroni — Infraestructura TI, redes y cloud';
const description='Experiencia profesional, certificaciones y formación de Juan Carlos Flores Aroni en infraestructura TI, redes y cloud.';
---
<!doctype html>
<html lang="es"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title} | JCF Infra</title><meta name="description" content={description}/>
<link rel="canonical" href="https://jcfinfra.com/es/cv/"/>
<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content="https://jcfinfra.com/es/cv/"/><meta property="og:image" content="https://jcfinfra.com/social-card.png"/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
</head><body>
<a class="skip-link" href="#main">Saltar al contenido</a>
<header class="site-header"><nav class="wrap cv-nav" aria-label="Navegación del CV"><a class="brand" href="/es/">JCF <span>INFRA</span></a><a href="/es/">Volver al portafolio</a><a href="/" lang="en">English portfolio</a></nav></header>
<main id="main" tabindex="-1" class="wrap cv-content"><article><slot/></article></main>
<Footer lang="es"/>
</body></html>
<style>
.cv-nav{display:flex;align-items:center;gap:24px;flex-wrap:wrap;padding-block:20px}.cv-nav .brand{margin-right:auto}.cv-content{max-width:960px;padding-block:48px 72px;overflow-wrap:anywhere}.cv-content :global(h1){font-size:clamp(2rem,5vw,3.2rem)}.cv-content :global(h2){font-size:1.6rem;margin-top:42px;padding-top:24px;border-top:1px solid var(--border)}.cv-content :global(h3){font-size:1.1rem;margin-top:28px}.cv-content :global(li){margin-bottom:10px}.cv-content :global(a){overflow-wrap:anywhere}@media print{header,footer,.skip-link{display:none}body{background:white;color:black;font-size:10pt}.cv-content{width:100%;max-width:none;padding:0}.cv-content :global(h1){font-size:22pt}.cv-content :global(h2){font-size:14pt;margin-top:20px;padding-top:12px;break-after:avoid}.cv-content :global(h3){break-after:avoid}a{color:black}}
</style>
